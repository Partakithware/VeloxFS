+/*
+ * Zero-fill file bytes [from, to).  Blocks are NOT zeroed on allocation (that was
+ * the v5 throughput killer), so any region a caller exposes without writing real
+ * data -- growth via truncate, or a write that starts past EOF -- must be zeroed
+ * here or it would read back whatever a previously deleted file left in the block.
+ */
+static int veloxfs_zero_fill(veloxfs_handle *fs, veloxfs_inode *in, uint64_t from, uint64_t to) {
+    if (to <= from) return veloxfs_OK;
+    uint64_t bs = veloxfs_BS(fs);
+    uint8_t *z = (uint8_t*)veloxfs_CALLOC(1, bs);
+    if (!z) return veloxfs_ERR_IO;
+    veloxfs_file tf;
+    veloxfs_MEMSET(&tf, 0, sizeof(tf));
+    tf.fs = fs; tf.inode = in; tf.position = from; tf.is_open = 1; tf.can_write = 1;
+    int ret = veloxfs_OK;
+    while (from < to && ret == veloxfs_OK) {
+        uint64_t n = bs - (from % bs);          /* up to the next block boundary, then whole blocks */
+        if (n > to - from) n = to - from;
+        ret = veloxfs_write(&tf, z, n);
+        from += n;
+    }
+    veloxfs_FREE(z);
+    return ret;
+}

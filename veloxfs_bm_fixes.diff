+/* Sum of blocks held by the inline extents (logical index where the overflow
+ * FAT chain begins). */
+static uint64_t veloxfs_inode_extent_blocks(const veloxfs_inode *inode) {
+    uint64_t t = 0;
+    if (inode->inode_flags & veloxfs_INODE_F_EXTENTS)
+        for (uint64_t i = 0; i < inode->extent_count; i++)
+            t += inode->extents[i].block_count;
+    return t;
+}
+
+/*
+ * Read or write `count` bytes of the part of a file that lives in the overflow
+ * FAT chain.  `byte_pos` is the absolute file offset and must be at or beyond
+ * the end of the inline extents.  *done_out receives the bytes transferred
+ * (may be < count if the chain ends early -- caller decides if that is an error).
+ */
+static int veloxfs_chain_io(veloxfs_handle *fs, veloxfs_inode *in, uint64_t byte_pos,
+                            void *buf, uint64_t count, int is_write, uint64_t *done_out) {
+    uint64_t bs  = veloxfs_BS(fs);
+    uint64_t off = byte_pos % bs;
+    uint64_t blk = veloxfs_fat_get_nth(fs, in->fat_head,
+                                       byte_pos / bs - veloxfs_inode_extent_blocks(in));
+    uint64_t done = 0;
+    uint8_t *p = (uint8_t*)buf;
+    while (done < count && blk != 0 && blk < fs->super.block_count) {
+        uint64_t chunk = bs - off;
+        if (chunk > count - done) chunk = count - done;
+        if (is_write) {
+            if (chunk < bs && veloxfs_read_block(fs, blk, fs->block_buf) != 0) return veloxfs_ERR_IO;
+            veloxfs_MEMCPY(fs->block_buf + off, p + done, chunk);
+            if (veloxfs_write_block(fs, blk, fs->block_buf) != 0) return veloxfs_ERR_IO;
+        } else {
+            if (veloxfs_read_block(fs, blk, fs->block_buf) != 0) return veloxfs_ERR_IO;
+            veloxfs_MEMCPY(p + done, fs->block_buf + off, chunk);
+        }
+        done += chunk; off = 0;
+        uint64_t nx = fs->fat[blk];
+        blk = (nx == veloxfs_FAT_EOF || nx == veloxfs_FAT_FREE || nx == veloxfs_FAT_BAD) ? 0 : nx;
+    }
+    *done_out = done;
+    return veloxfs_OK;
+}
